NEXT_PUBLIC_CONVEX_URL=https://insightful-chihuahua-895.convex.cloud
CONVEX_DEPLOY_KEY=
CONVEX_SERVER_SECRET=
RATE_LIMIT_HMAC_SECRET=
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=openai/gpt-oss-20b
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BOT_USER_ID=
# Keep both false until X grants written reply approval and the signer has
# passed production security review. No reply polling cron is installed.
X_REPLIES_ENABLED=false
X_REPLY_USER_DAILY_LIMIT=30
X_REPLY_GLOBAL_DAILY_LIMIT=250
X_REPLY_USER_WINDOW_LIMIT=5
X_REPLY_GLOBAL_WINDOW_LIMIT=25
X_REPLY_WINDOW_MINUTES=10
X_REPLY_COOLDOWN_SECONDS=30
# WALLET_FEATURE_PROMPTS_ENABLED=true
X_CRYPTO_EXECUTION_ENABLED=false

# HTTPS KMS/MPC signer gateway. It owns no application data and must enforce
# chain, contract, source-wallet, amount, simulation, and idempotency policy.
WALLET_SIGNER_URL=
WALLET_SIGNER_TOKEN=
WALLET_SIGNER_IDEMPOTENCY_SECRET=
# Coinbase CDP server-wallet credentials. Keep these in Vercel only, never in
# Convex or NEXT_PUBLIC variables.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
# Required fail-closed ceiling for the native ETH value of one transaction.
WALLET_MAX_TRANSACTION_USD=10000
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Every value-moving operation must leave at least this USD-equivalent amount
# of native Robinhood Chain ETH after transferred value and maximum gas cost.
WALLET_MIN_GAS_RESERVE_USD=0.50

# Verified Robinhood Chain PotatoCurvePad. It opens the initial single-sided
# Uniswap V3 bonding curve through payable createToken(...).
POTATOPAD_CURVE_ADDRESS=0xbE2aCD9044516399aa4C697c299571664fBe9d4B
